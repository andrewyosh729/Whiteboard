@using System.Text.Json
@using System.Text.Json.Serialization
@using Newtonsoft.Json
@using Whiteboard.Controllers
@using Whiteboard.Services
<input type="hidden" runat="server" id="id" value="@(((UserInitializationData)Model).UserId)"/>

@{
    string existingDrawings = JsonConvert.SerializeObject(((UserInitializationData)Model).ExistingDrawings);
}

<div id="data-container" existing-drawings='@Html.Raw(existingDrawings)'></div>

<body>
<script>
    window.existingDrawings = @Html.Raw(existingDrawings);
</script>
<script type="importmap">
    {
      "imports": {
        "three": "https://cdn.jsdelivr.net/npm/three@0.168.0/build/three.module.js",
        "three/addons/": "https://cdn.jsdelivr.net/npm/three@0.168.0/examples/jsm/",
        "meshline": "https://cdn.jsdelivr.net/npm/meshline@3.3.1/+esm"
    }
  }
</script>
<script src="~/js/signalr/dist/browser/signalr.js"></script>
<script type="module" src="~/js/site.js" asp-append-version="true"></script>
</body>